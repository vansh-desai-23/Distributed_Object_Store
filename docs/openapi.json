    "/api/v1/objects": {
      "post": {
        "summary": "Upload",
        "operationId": "upload_api_v1_objects_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "headers": {
              "Idempotency-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                },
                "description": "Present on keyed uploads; true when returning the saved response."
              }
            }
          },
          "409": {
            "description": "Conflicting key or upload still in progress"
          },
          "410": {
            "description": "Original keyed upload was deleted"
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "description": "Reuse for identical upload retries; conflicting requests return 409, deleted originals return 410."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "metadata": {
                    "type": "string",
                    "default": "{}",
                    "description": "JSON object containing custom string key-value pairs"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List Objects",
        "operationId": "list_objects_api_v1_objects_get",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
